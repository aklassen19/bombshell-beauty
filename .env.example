# ─── Booking form ─────────────────────────────────────────────────────────
# Inquiries are emailed straight to Krista. Pick ONE of the two below.
# Without these the form still works, but it opens the bride's own mail app
# instead of delivering directly. See SETUP.md step 3.

# Option A — Web3Forms (no account needed; recommended)
PUBLIC_FORM_ENDPOINT="https://api.web3forms.com/submit"
PUBLIC_FORM_ACCESS_KEY=""

# Option B — Formspree (needs a free account)
# PUBLIC_FORM_ENDPOINT="https://formspree.io/f/xxxxxxxx"

# ─── CMS login (only needed for /admin) ───────────────────────────────────
# From the GitHub OAuth App. The secret is server-side only — never prefix
# these with PUBLIC_. See SETUP.md step 4.
GITHUB_OAUTH_ID=""
GITHUB_OAUTH_SECRET=""

# ─── Domain ───────────────────────────────────────────────────────────────
# Only once Krista has a real domain. Left unset, the site follows whatever
# Vercel is serving it on, which is correct for now.
# SITE_URL="https://herdomain.ca"
