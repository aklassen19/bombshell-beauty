---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Curve from '../components/Curve.astro';
import Testimonials from '../components/Testimonials.astro';
import site from '../content/site.json';
import services from '../content/services.json';
import gallery from '../content/gallery.json';
import { resolveGallery } from '../lib/photos';
import hero from '../assets/photos/bridal-makeup-application.jpg';
import portrait from '../assets/photos/krista-mirror.jpg';

// The hero photo is already at the top of the page; showing it again a
// scroll later makes the portfolio look thinner than it is.
const photos = resolveGallery(gallery.items)
  .filter((p) => p.image.src !== hero.src)
  .slice(0, 6);

// Below three, the section is the hero photo again plus whatever else is
// in the gallery — not a portfolio. It appears on its own once there are
// enough real weddings to fill it, the same way the reviews do.
const showWork = photos.length >= 3;

const offerings = [
  {
    title: 'Bridal makeup',
    copy: 'A soft, luminous look built to last a fourteen-hour day and photograph the way you actually look, not the way a flash decides you do.',
    from: services.groups[0].items[0].price,
  },
  {
    title: 'Bridal hair',
    copy: 'Romantic styling, from a loose undone wave to a structured updo that survives the dance floor. Hair and makeup by one artist, on one timeline.',
    from: services.groups[1].items[0].price,
  },
  {
    title: 'Your bridal party',
    copy: 'Mothers, sisters, bridesmaids and juniors, all finished before the photographer arrives. Krista builds the morning schedule so nobody is rushed.',
    from: services.groups[0].items[3].price,
  },
];

const steps = [
  {
    n: '01',
    title: 'Send your inquiry',
    copy: `Tell Krista your date, where you are getting ready and roughly who needs what. She replies within ${site.responseTime}.`,
  },
  {
    n: '02',
    title: 'Hold your date',
    copy: `Krista sends a quote and a contract, and holds your date for one week while you decide. Sign it with a ${site.depositPercent}% deposit and the date is yours.`,
  },
  {
    n: '03',
    title: 'Have your trial',
    copy: 'Optional, and worth it. You settle the look together with time to change your mind, so the wedding morning holds no surprises.',
  },
  {
    n: '04',
    title: 'Wedding day',
    copy: `The balance is due ${site.balanceDueDays} days before. Krista arrives at your venue with everything, on the timeline in your contract.`,
  },
];
---

<Base
  title={`${site.businessName} — Bridal Hair & Makeup in Edmonton`}
  bareTitle
  description={`Bridal hair and makeup artistry by ${site.artist}. On-location across Edmonton and central Alberta, with over ${site.yearsExperience} years of wedding mornings behind her.`}
>
  <!-- ─── Hero ─── -->
  <section class="hero">
    <Curve from="top-right" size={1.1} />
    <div class="shell hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Edmonton, Alberta</p>
        <h1>Elegant. Romantic.<br />Beautiful.</h1>
        <p class="lede">
          Bridal hair and makeup artistry by {site.artist} — on location,
          unhurried, and built around the day you have actually planned.
        </p>
        <div class="hero-actions">
          <a href="/book/" class="btn">Check your date</a>
          <a href="/gallery/" class="textlink">See her work</a>
        </div>
      </div>

      <div class="hero-photo">
        <Image
          src={hero}
          alt="Krista applying lip colour to a bride on her wedding morning"
          widths={[400, 700, 1000]}
          sizes="(max-width: 900px) 92vw, 460px"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>
  </section>

  <!-- ─── What she does ─── -->
  <section class="band">
    <div class="shell">
      <div class="center">
        <p class="eyebrow">What Krista does</p>
        <h2>Hair and makeup, one artist,<br />no 7am scramble.</h2>
        <hr class="rule rule--center" />
      </div>

      <ul class="offerings">
        {
          offerings.map((o) => (
            <li class="offering">
              <h3>{o.title}</h3>
              <p>{o.copy}</p>
              <p class="from">
                From <strong>{o.from}</strong>
              </p>
            </li>
          ))
        }
      </ul>

      <p class="center"><a href="/services/" class="textlink">Full price list</a></p>
    </div>
  </section>

  <!-- ─── Meet Krista ─── -->
  <!-- Brides are booking a person, not a service list. Words match the
       About page, in her third-person voice. -->
  <section class="band band--blush meet">
    <div class="shell meet-grid">
      <div class="meet-photo" data-reveal>
        <Image
          src={portrait}
          alt="Krista Matthews holding a makeup brush, reflected in a gilt mirror"
          widths={[320, 520, 760]}
          sizes="(max-width: 800px) 70vw, 360px"
          loading="lazy"
        />
      </div>
      <div class="meet-copy">
        <p class="eyebrow">Meet your artist</p>
        <h2>{site.artist}</h2>
        <hr class="rule" />
        <p>
          A certified makeup artist and hair stylist with over {
            site.yearsExperience
          } years of wedding mornings behind her. She has learned that the
          makeup is only half the job. The rest is timing, temperament and
          keeping a room of nervous people calm while the photographer circles.
        </p>
        <p>
          Your trial and your wedding morning are both with Krista, so on the
          day she already knows the look you settled on together.
        </p>
        <p class="meet-cta"><a href="/about/" class="textlink">About Krista</a></p>
      </div>
    </div>
  </section>

  <!-- ─── How it works ─── -->
  <section class="band">
    <div class="shell">
      <div class="center">
        <p class="eyebrow">How booking works</p>
        <h2>Four steps, no guesswork.</h2>
        <hr class="rule rule--center" />
      </div>

      <ol class="steps">
        {
          steps.map((s) => (
            <li>
              <span class="step-n" aria-hidden="true">
                {s.n}
              </span>
              <h3>{s.title}</h3>
              <p>{s.copy}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ─── Gallery preview ─── -->
  {
    showWork && (
      <section class="band band--blush">
        <div class="shell">
          <div class="center">
            <p class="eyebrow">Recent work</p>
            <h2>Real brides, real mornings.</h2>
            <hr class="rule rule--center" />
          </div>
          <ul class="grid">
            {photos.map((p, i) => (
              <li data-reveal style={`transition-delay:${(i % 3) * 90}ms`}>
                <Image
                  src={p.image}
                  alt={p.alt}
                  widths={[320, 560, 800]}
                  sizes="(max-width: 700px) 92vw, (max-width: 1000px) 44vw, 340px"
                  loading={i < 2 ? 'eager' : 'lazy'}
                />
              </li>
            ))}
          </ul>
          <p class="center">
            <a href="/gallery/" class="textlink">
              See the full gallery
            </a>
          </p>
        </div>
      </section>
    )
  }

  <Testimonials />

  <!-- ─── Closing CTA ─── -->
  <section class="band closing">
    <Curve from="bottom-left" size={1.3} />
    <div class="shell--narrow center">
      <h2 class="closing-title">
        Your wedding day deserves<br />nothing less than perfection.
      </h2>
      <p class="lede">
        Krista can only be at one wedding a day, so it is worth checking your
        date early. Send your details and she will come back within {
          site.responseTime
        } with a quote for your day.
      </p>
      <p class="closing-cta"><a href="/book/" class="btn">Send an inquiry</a></p>
    </div>
  </section>
</Base>

<style>
  /* ─── Hero ─── */
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(36px, 5vw, 64px) clamp(48px, 7vw, 92px);
  }

  .hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr minmax(0, 420px);
    gap: clamp(32px, 6vw, 72px);
    align-items: center;
  }

  /* Capped below the global h1 scale — the whole hero has to clear the fold
     on a laptop, and three lines of 74px display type does not. */
  .hero-copy h1 {
    font-size: clamp(36px, 5vw, 58px);
    margin-bottom: 22px;
  }

  .hero-copy .lede {
    margin-bottom: 34px;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 30px;
    flex-wrap: wrap;
  }

  .hero-photo :global(img) {
    width: 100%;
    border-radius: 210px 210px var(--radius) var(--radius);
    box-shadow: var(--shadow-lift);
    /* Taller than the source frame, so `cover` crops top and bottom and
       object-position can pull the faces into the arch. */
    aspect-ratio: 1 / 1.12;
    max-height: 500px;
    object-fit: cover;
    object-position: center 26%;
  }

  /* ─── Offerings ─── */
  .offerings {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: clamp(20px, 3vw, 34px);
    margin-block: clamp(40px, 6vw, 64px) 44px;
  }

  .offering {
    background: var(--blush);
    border-radius: var(--radius);
    padding: clamp(28px, 3.4vw, 40px);
    display: flex;
    flex-direction: column;
  }

  .offering h3 {
    margin-bottom: 14px;
  }

  .offering p {
    font-size: 15px;
    line-height: 1.8;
  }

  .from {
    margin-top: auto;
    padding-top: 22px;
    font-size: 12px !important;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--brown-soft);
  }

  .from strong {
    font-weight: 500;
    color: var(--brown-deep);
  }

  /* ─── Gallery grid ─── */
  .grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: clamp(14px, 2vw, 22px);
    margin-block: clamp(40px, 6vw, 60px) 36px;
  }

  .grid :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius);
    box-shadow: var(--shadow-soft);
  }

  /* ─── Meet Krista ─── */
  .meet-grid {
    display: grid;
    grid-template-columns: minmax(0, 360px) 1fr;
    gap: clamp(32px, 6vw, 80px);
    align-items: center;
  }

  .meet-photo :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 180px 180px var(--radius) var(--radius);
    box-shadow: var(--shadow-lift);
  }

  .meet-copy p + p {
    margin-top: 16px;
  }

  .meet-copy p {
    max-width: 52ch;
  }

  .meet-cta {
    margin-top: 28px !important;
  }

  /* ─── Steps ─── */
  .steps {
    list-style: none;
    counter-reset: step;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: clamp(28px, 4vw, 48px);
    margin-top: clamp(44px, 6vw, 68px);
  }

  .steps li {
    border-top: 1px solid var(--divider);
    padding-top: 24px;
  }

  .step-n {
    display: block;
    font-family: var(--font-display);
    font-size: 30px;
    color: var(--blush-deep);
    margin-bottom: 10px;
  }

  .steps h3 {
    font-size: 21px;
    margin-bottom: 12px;
  }

  .steps p {
    font-size: 15px;
    line-height: 1.8;
  }

  /* ─── Closing ─── */
  .closing {
    position: relative;
    overflow: hidden;
  }

  .closing-title {
    font-style: italic;
    font-weight: 400;
    margin-bottom: 22px;
  }

  .closing-cta {
    margin-top: 36px;
  }

  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .hero-copy .lede {
      margin-inline: auto;
    }

    .hero-actions {
      justify-content: center;
    }

    .meet-grid {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .meet-photo {
      max-width: 300px;
      margin-inline: auto;
    }

    .meet-copy p {
      margin-inline: auto;
    }

    .meet-copy .rule {
      margin-inline: auto;
    }

    .hero-photo {
      order: -1;
      max-width: 400px;
      margin-inline: auto;
    }

    /* Shorter on a phone so the headline still clears the fold — a bride
       should know what the business is without scrolling. */
    .hero-photo :global(img) {
      border-radius: 170px 170px var(--radius) var(--radius);
      aspect-ratio: 1 / 1.05;
      max-height: 360px;
    }
  }
</style>
