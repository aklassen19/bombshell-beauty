---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Curve from '../components/Curve.astro';
import site from '../content/site.json';
import portrait from '../assets/photos/krista-mirror.jpg';

const facts = [
  { label: 'Based in', value: `${site.city}, Alberta` },
  { label: 'Experience', value: `${site.yearsExperience}+ years` },
  { label: 'Specialty', value: 'Bridal hair & makeup' },
  { label: 'Where', value: 'On location, always' },
];
---

<Base
  title="About Krista"
  description={`Krista Matthews is a certified freelance makeup artist and hair stylist with over ${site.yearsExperience} years creating bridal looks across Edmonton and central Alberta.`}
>
  <section class="band intro">
    <Curve from="top-left" size={1} />
    <div class="shell">
      <div class="head center">
        <p class="eyebrow">Meet the artist</p>
        <h1>Krista Matthews</h1>
        <hr class="rule rule--center" />
      </div>

      <div class="grid">
        <div class="photo">
          <Image
            src={portrait}
            alt="Krista Matthews holding a makeup brush, reflected in a gilt mirror"
            widths={[380, 620, 900]}
            sizes="(max-width: 880px) 88vw, 420px"
            loading="eager"
          />
        </div>

        <div class="copy">
          <p class="lede">
            Blonde Bombshell Beauty is a one-artist studio in {site.city},
            specialising in bridal makeup and hair for weddings and the days
            that matter almost as much.
          </p>
          <p>
            Krista is a certified freelance makeup artist and hair stylist with
            over {site.yearsExperience} years of wedding mornings behind her. In
            that time she has learned that the makeup is only half the job. The
            rest is timing, temperament and keeping a room of nervous people
            calm while the photographer circles.
          </p>
          <p>
            She works on location, always, so nobody is driving between a salon
            and a venue in a dress. She builds the morning schedule herself and
            puts it in your contract, with an arrival time and a finish time,
            so you know exactly when you will be ready.
          </p>
          <p>
            The look itself is soft, luminous and deliberately yours. Krista is
            not interested in sending you down the aisle as a version of
            somebody else, and she would rather spend an extra ten minutes on
            a trial than have you spend the day adjusting.
          </p>

          <dl class="facts">
            {
              facts.map((f) => (
                <div>
                  <dt>{f.label}</dt>
                  <dd>{f.value}</dd>
                </div>
              ))
            }
          </dl>

          <div class="actions">
            <a href="/book/" class="btn">Check your date</a>
            <a href="/gallery/" class="textlink">See her work</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .intro {
    position: relative;
    overflow: hidden;
  }

  .head {
    margin-bottom: clamp(40px, 6vw, 64px);
  }

  .grid {
    display: grid;
    grid-template-columns: 420px 1fr;
    gap: clamp(32px, 6vw, 76px);
    align-items: start;
  }

  .photo :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 210px 210px var(--radius) var(--radius);
    box-shadow: var(--shadow-lift);
  }

  .copy p + p {
    margin-top: 18px;
  }

  .copy .lede {
    margin-bottom: 24px;
    color: var(--brown-deep);
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 20px 28px;
    margin-block: 38px;
    padding-top: 32px;
    border-top: 1px solid var(--divider);
  }

  .facts dt {
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--brown-soft);
    margin-bottom: 6px;
  }

  .facts dd {
    font-family: var(--font-display);
    font-size: 19px;
    color: var(--brown-deep);
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 28px;
    flex-wrap: wrap;
  }

  @media (max-width: 880px) {
    .grid {
      grid-template-columns: 1fr;
    }

    .photo {
      max-width: 380px;
      margin-inline: auto;
    }
  }
</style>
