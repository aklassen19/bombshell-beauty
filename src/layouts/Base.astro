---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import site from '../content/site.json';

interface Props {
  title: string;
  description: string;
  /** Leave off on the home page, where the brand name stands alone. */
  bareTitle?: boolean;
}

const { title, description, bareTitle = false } = Astro.props;

const pageTitle = bareTitle ? title : `${title} — ${site.businessName}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.jpg', Astro.site);

// Google picks this up for the local-business panel. Prices and policies are
// pulled from the same content files the rest of the site reads, so they can
// never drift apart.
const schema = {
  '@context': 'https://schema.org',
  '@type': 'HealthAndBeautyBusiness',
  name: site.businessName,
  description: site.tagline,
  image: ogImage.href,
  url: Astro.site?.href,
  email: site.email,
  telephone: site.phone,
  founder: { '@type': 'Person', name: site.artist },
  priceRange: '$$',
  areaServed: site.areaServed.map((name: string) => ({ '@type': 'City', name })),
  address: {
    '@type': 'PostalAddress',
    addressLocality: site.city,
    addressRegion: site.region,
    addressCountry: 'CA',
  },
  sameAs: [site.instagram],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.businessName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="theme-color" content="#f1e4dd" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600&family=Poppins:wght@300;400;500&display=swap"
    />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(schema)}
      is:inline
    />
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
